---
import {
	ThreeColumnTextSection,
	StickyTextImageSection,
	CtaCardSection
} from '@components/odyssey-theme';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Page.astro';
import TextAndImageHero from '../components/sections/heros/TextAndImageHero.astro';
import TestimonialCarousel from '../components/sections/TestimonialCarousel.astro';

const seo = {
	title: 'Niko Börger',
	description: 'Freiberuflicher Senior Fullstack Developer'
};

const availabilityDateStr = '2026-10-01';

const testimonials = [
	{
		quoteDe: `Niko überzeugt nicht nur durch technische Exzellenz und einen hohen Qualitätsanspruch, sondern auch durch seine professionelle, positive Ausstrahlung im Kundenkontakt. Jeder unserer Kunden ist durchweg begeistert von seiner Arbeit und der Zusammenarbeit. Er agiert zuverlässig, lösungsorientiert und mit einem feinen Gespür für die Bedürfnisse unterschiedlicher Stakeholder.`,
		quoteEn: `Niko stands out not only through technical excellence and a high quality bar, but also through his professional, positive presence in client interactions. Every one of our clients has been consistently impressed with his work and the collaboration. He is reliable, solutions-oriented, and has a fine sense for the needs of different stakeholders.`,
		nameDe: `Jan Wittern`,
		roleDe: `Senior Manager Solutions bei Opitz Consulting`,
		roleEn: `Senior Manager Solutions at Opitz Consulting`
	},
	{
		quoteDe: `Niko beeindruckt durch seine schnelle Auffassungsgabe, seinen hohen Qualitätsanspruch und seinen ausgeprägten Teamgeist. Er arbeitet beharrlich und strukturiert an Lösungen, bis diese wirklich überzeugen, und behält dabei auch in komplexen Situationen den Überblick. Durch seine wertschätzende Art trägt er maßgeblich zu einer positiven Zusammenarbeit im Team und mit Stakeholdern bei. Ich würde jederzeit wieder sehr gern mit ihm zusammenarbeiten.`,
		quoteEn: `Niko impresses through his quick grasp, his high quality bar, and his strong team spirit. He works persistently and methodically on solutions until they are truly convincing, keeping a clear overview even in complex situations. Through his appreciative manner, he contributes substantially to positive collaboration within the team and with stakeholders. I would gladly work with him again at any time.`,
		nameDe: `Mike Groezinger`,
		roleDe: `Lead Software Engineer & Solution Architect · 2025`,
		roleEn: `Lead Software Engineer & Solution Architect · 2025`
	},
	{
		quoteDe: `Niko gehört fachlich wie menschlich zu den starken Entwicklern, mit denen ich zusammenarbeiten durfte. Er hat regelmäßig Verantwortung übernommen, Themen strukturiert vorangetrieben und dabei andere mitgenommen. Ich konnte mich jederzeit auf ihn verlassen. Durch seine hilfsbereite, angenehme Art war er im gesamten Team überaus geschätzt.`,
		quoteEn: `Niko is one of the strong developers I have worked with, both technically and as a person. He consistently took ownership, drove topics forward in a structured way, and brought others along with him. I could rely on him at any time. His helpful, friendly manner made him highly valued across the whole team.`,
		nameDe: `Markus Klußmann`,
		roleDe: `Technical Lead bei OTTO`,
		roleEn: `Technical Lead at OTTO`
	},
	{
		quoteDe: `In meinem Folgeprojekt merke ich gerade nochmal besonders, wie wichtig es war, jemanden wie dich im Team gehabt zu haben, der für hohe Coding-Qualität gesorgt hat. Wir verlieren hier unglaublich viel Zeit, Nerven und Geld durch schlechte Codequalität. Ich bin froh, dass ich so viel von dir lernen konnte.`,
		quoteEn: `In my follow-up project, I am noticing again just how important it was to have someone like you on the team — someone who took care of high coding quality. Here we are losing an incredible amount of time, nerves, and money to poor code quality. I am glad I got to learn so much from you.`,
		nameDe: `Martin Wepner`,
		roleDe: `Freelance Senior Fullstack Developer · Projekt OTTO`,
		roleEn: `Freelance Senior Fullstack Developer · OTTO project`
	},
	{
		quoteDe: `Niko bringt fachlich und technisch starke Lösungen mit hohem Qualitätsanspruch ein und sorgt durch seine positive Art für ein motivierendes Teamklima. Er ist jederzeit absolut verlässlich und damit sowohl technisch als auch menschlich ein Gewinn für jedes Team.`,
		quoteEn: `Niko delivers technically strong solutions with a high quality bar and creates a motivating team atmosphere through his positive attitude. He is absolutely reliable at all times. A gain for any team, both technically and as a person.`,
		nameDe: `Max Dietrich`,
		roleDe: `Freelance Senior Fullstack Developer · Projekt OTTO`,
		roleEn: `Freelance Senior Fullstack Developer · OTTO project`
	},
	{
		quoteDe: `Ich habe Niko als meinen Mentor erlebt, der komplexe Themen mit Geduld und hoher fachlicher Qualität vermittelt. Seine positive, wertschätzende Art hat jede Session bereichert. Besonders beeindruckt haben mich seine Klarheit in der Kommunikation und sein konsequenter Anspruch an gute Lösungen.`,
		quoteEn: `I experienced Niko as my mentor, someone who teaches complex topics with patience and deep technical quality. His positive, appreciative manner enriched every session. What impressed me most was his clarity in communication and his consistent commitment to good solutions.`,
		nameDe: `Zeinab Labaf`,
		roleDe: `Junior Entwicklerin`,
		roleEn: `Junior Developer`
	}
];

// Format date for German (DD.MM.YYYY)
const formatDateDE = (dateStr: string) => {
	const date = new Date(dateStr);
	return date.toLocaleDateString('de-DE', {
		month: 'short',
		day: 'numeric',
		year: 'numeric'
	});
};

// Format date for English (e.g., "Apr 1, 2026" )
const formatDateEN = (dateStr: string) => {
	const date = new Date(dateStr);
	return date.toLocaleDateString('en-US', {
		month: 'short',
		day: 'numeric',
		year: 'numeric'
	});
};

const availabilityDateDE = formatDateDE(availabilityDateStr);
const availabilityDateEN = formatDateEN(availabilityDateStr);
---

<Layout {seo}>
	<TextAndImageHero reversed>
		<div slot="text-container">
			<h1>Niko Börger</h1>
			<p class="subtitle">
				<span data-i18n-en="Freelance Senior Fullstack Developer &amp; Tech Lead">
					Freiberuflicher Senior Fullstack Developer & Tech Lead
				</span><br>
				<span class="location" data-i18n-en="Hamburg, Germany · 11+ years of experience">Hamburg, Germany · 11+ Jahre Erfahrung</span>
			</p>
		<span id="availability-badge" class="availability-badge badge" data-availability-date={availabilityDateStr}>
			<span data-i18n-en="Expected availability:">vorauss. Verfügbarkeit:</span> <span class="availability-date" data-i18n-en={availabilityDateEN}>{availabilityDateDE}</span>
		</span>
			<div class="tech-badges">
				<span class="badge badge--primary">Java / Kotlin</span>
				<span class="badge badge--primary">TypeScript</span>
				<span class="badge badge--primary">Golang</span>
				<span class="badge badge--primary">Spring Boot</span>
				<span class="badge badge--primary">Node.js</span>
				<span class="badge badge--primary">AWS Cloud</span>
				<span class="badge badge--primary">Kubernetes</span>
				<span class="badge badge--primary">Microservices</span>
				<span class="badge badge--primary">DevOps</span>
				<span class="badge badge--primary">Claude Code</span>
				<a
					href="/niko-boerger-profil.pdf"
					target="_blank"
					rel="noopener noreferrer"
					class="badge profile-download"
					aria-label="Profil-PDF in neuem Tab öffnen"
				>
					<Icon name="mdi:file-download-outline" width="14" height="14" aria-hidden="true" />
					<span data-i18n-en="Download Profile PDF">Download Profil-PDF</span>
				</a>
			</div>
		</div>
		<picture slot="image-container">
			<img
				src="/assets/images/profile_pic.jpg"
				alt="Niko Börger"
				id="home-hero-image"
			/>
		</picture>
	</TextAndImageHero>

	<TestimonialCarousel testimonials={testimonials} />

	<ThreeColumnTextSection>
		<div slot="column-1-body">
			<h2 data-i18n-en="My Standard">Mein Anspruch</h2>
			<p data-i18n-html-en="I combine the highest quality with genuine team culture. I&apos;m not just a developer — I&apos;m a <strong>de-stresser</strong>. Whether it&apos;s a legacy monster, a chaotic MVP, or a greenfield project: I bring the structure that makes both the product convince and the team behind it.">
				Ich verbinde höchste Qualität mit echter Teamkultur. Ich bin nicht nur Entwickler,
				ich bin <strong>Entstresser</strong>. Ob Legacy-Monster, chaotisches MVP oder
				Grüne-Wiese-Projekt: Ich sorge mit Struktur dafür, dass nicht nur das Produkt überzeugt,
				sondern auch das Team, das dahintersteht.
			</p>
		</div>
		<div slot="column-2-body">
			<h2 data-i18n-en="When You Need Me">Wann Sie mich brauchen</h2>
			<p data-i18n-html-en="When your architecture keeps you up at night. When your team isn&apos;t shipping but groaning. When you&apos;re looking for someone who lives technical excellence and still posts a GIF every now and then.">
				Wenn Ihre Architektur Sie nachts wach hält. Wenn Ihr Team nicht liefert, sondern stöhnt.
				Wenn Sie jemanden suchen, der technische Exzellenz lebt und trotzdem auch mal ein GIF postet.
			</p>
		</div>
		<div slot="column-3-body">
			<h2 data-i18n-en="My Promise">Mein Versprechen</h2>
			<p data-i18n-html-en="<strong>Less chaos, fewer bugs, less drama.</strong> In return: modern ways of working, clean architecture, and more relaxed faces in the daily standup.">
				<strong>Weniger Chaos, weniger Bugs, weniger Drama.</strong>
				Dafür moderne Arbeitsweisen, saubere Architektur und mehr entspannte Gesichter im Daily.
			</p>
		</div>
	</ThreeColumnTextSection>

	<StickyTextImageSection>
		<div slot="text-container">
			<h2 data-i18n-en="Technical Excellence from Backend to AI">
				Technische Exzellenz von Backend bis KI
			</h2>
			<h3 data-i18n-en="Fullstack Engineering">Fullstack-Entwicklung</h3>
			<p data-i18n-html-en='My focus is on robust, scalable backends with a clear architecture. In cross-functional DevOps teams, I build APIs, microservices, and event-driven systems that run reliably, are thoroughly tested, and stay maintainable over the long term. On the frontend side, I&apos;ve helped build various pages on <a href="https://www.otto.de" target="_blank" rel="noopener noreferrer">OTTO.de</a> and shipped complex UIs that run cleanly and robustly in production.'>
				Mein Schwerpunkt liegt auf robusten, skalierbaren Backends mit klarer Architektur.
				In cross-funktionalen DevOps-Teams entwickle ich APIs, Microservices und
				eventgetriebene Systeme, die stabil laufen, sauber getestet sind und langfristig
				wartbar bleiben. Auf der Frontend-Seite habe ich unter anderem verschiedene Seiten
				auf <a href="https://www.otto.de" target="_blank" rel="noopener noreferrer">OTTO.de</a>
				mit aufgebaut und komplexe UIs umgesetzt, die technisch sauber und robust in Produktion laufen.
			</p>
			<h3 data-i18n-en="Cloud &amp; DevOps">Cloud & DevOps</h3>
			<p data-i18n-html-en="Infrastructure is part of the software for me, not a side concern. In DevOps setups, I automate build, test, and deployment processes, establish trunk-based development and CI/CD, and build cloud and Kubernetes environments that are reliable, secure, and manageable.">
				Infrastruktur ist für mich Teil der Software, nicht Beiwerk.
				In DevOps-Setups automatisiere ich Build-, Test- und Deployment-Prozesse,
				etabliere Trunk-Based-Development und CI/CD und baue Cloud- und Kubernetes-Umgebungen,
				die zuverlässig, sicher und beherrschbar sind.
			</p>
			<h3 data-i18n-en="AI-Driven Engineering">KI-getriebenes Arbeiten</h3>
			<p data-i18n-html-en="AI isn&apos;t a buzzword for me, it&apos;s a way of working. With Claude Code, GitHub Copilot, and Compound Engineering, I get from idea to production faster. I bring that way of working into the team and make sure AI acts not just as a tool but as a lever for better software.">
				KI ist für mich kein Buzzword, sondern Arbeitsweise.
				Mit Claude Code, GitHub Copilot und Compound Engineering komme ich schneller von der Idee
				zum produktiven System.
				Ich bringe diese Arbeitsweise ins Team und sorge dafür, dass KI nicht nur als Tool,
				sondern als Hebel für bessere Software wirkt.
			</p>
		</div>
		<picture slot="image-container">
			<img
				src="/assets/images/devops.png"
				alt="DevOps"
			/>
		</picture>
	</StickyTextImageSection>

	<CtaCardSection
		background="var(--theme-surface-2)"
		color="var(--theme-on-surface-2)"
	>
		<h2 data-i18n-en="Your Partner for Software Projects">
			Ihr Partner für Softwareprojekte
		</h2>
		<p data-i18n-en="Looking for a strong partner for your project? I&apos;d love to hear from you.">
			Sie suchen einen starken Partner für Ihr Projekt? Ich freue mich auf Ihre Nachricht.
		</p>
		<div>
			<p>
				<em id="phone-placeholder"
				>[Please enable Javascript]</em> • <em id="mail-placeholder"
			>[Please enable Javascript]</em>
			</p>
		</div>
	</CtaCardSection>
	<script>
		const user = 'niko';
		const domain = 'boerger.dev';
		const mailPlaceholder = document.getElementById('mail-placeholder');
		if (mailPlaceholder) {
			mailPlaceholder.innerHTML = `<a href="mailto:${user}@${domain}">${user}@${domain}</a>`;
		}

		const phone = '+49 174 6098501';
		const phonePlaceholder = document.getElementById('phone-placeholder');
		if (phonePlaceholder) {
			phonePlaceholder.textContent = phone;
		}
	</script>
	<script>
		const badge = document.getElementById('availability-badge');
		if (badge) {
			const availabilityDateStr = badge.getAttribute('data-availability-date');
			const availabilityDate = new Date(availabilityDateStr);
			const today = new Date();
			const msPerMonth = 30.44 * 24 * 60 * 60 * 1000;
			const diffMs = availabilityDate.getTime() - today.getTime();
			const diffMonths = diffMs / msPerMonth;
			let badgeClass = 'badge--green';
			if (diffMonths >= 6) {
				badgeClass = 'badge--red';
			} else if (diffMonths > 2) {
				badgeClass = 'badge--yellow';
			}
			badge.classList.remove('badge--green', 'badge--yellow', 'badge--red');
			badge.classList.add(badgeClass);
		}
	</script>
</Layout>
