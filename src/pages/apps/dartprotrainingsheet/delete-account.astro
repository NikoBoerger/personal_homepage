---
import AppLayout from '../../../layouts/AppLayout.astro';
---

<AppLayout
	app="dartprotrainingsheet"
	seo={{
		title: 'Delete Account | Dart Pro Training Sheet',
		description: 'How to request deletion of your account and data for the Dart Pro Training Sheet app.',
	}}
>
	<h1>Request Data Deletion</h1>

	<section class="app-card">
		<p>
			To completely remove your Google account from this app, and thus delete all saved data, just write an
			email to <span class="app-mail">[Please enable Javascript]</span>.
		</p>
		<p>
			Please name the Google email address you used to sign in, so I can identify the account and delete it.
		</p>
	</section>
</AppLayout>
