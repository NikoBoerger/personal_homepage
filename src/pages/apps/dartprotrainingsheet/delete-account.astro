---
import AppLayout from '../../../layouts/AppLayout.astro';
---

<AppLayout
	app="dartprotrainingsheet"
	seo={{
		title: 'Delete Account | Dart Pro Training Sheet',
		description: 'How to request deletion of your account and data for the Dart Pro Training Sheet app.',
	}}
>
	<h1>Request Data Deletion</h1>

	<section class="app-card">
		<p>
			If you signed in with your Google account (Android), you can request deletion of the login information
			associated with your account. Just write an email to <span class="app-mail">[Please enable Javascript]</span>,
			naming the Google email address you used to sign in, and I will delete the login records I hold for you
			(these are recorded in the app's analytics).
		</p>
		<p>
			Your training data backup is stored in your own Google Drive, not on my servers. You can delete it yourself
			at any time by removing the app's backup data in your Google Drive, or by revoking the app's access to your
			Google account in your Google Account settings. Training data on your device is removed when you delete it
			in the app or uninstall the app.
		</p>
	</section>
</AppLayout>
