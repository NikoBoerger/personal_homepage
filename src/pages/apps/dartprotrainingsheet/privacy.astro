---
import DartProLayout from '../../../layouts/DartProLayout.astro';
import LegalHero from '../../../components/dartpro/LegalHero.astro';
import { dartProTrainingSheet as app } from '../../../config/dartprotrainingsheet.js';

const toc = [
	{ id: 'controller', label: 'Who Is Responsible' },
	{ id: 'collection', label: 'Information Collection and Use' },
	{ id: 'on-device', label: 'Data Stored on Your Device' },
	{ id: 'backup', label: 'Google Sign-In and Drive Backup' },
	{ id: 'leaderboard', label: 'Leaderboard' },
	{ id: 'transfer', label: 'Transfer and Sharing' },
	{ id: 'advertising', label: 'Advertising' },
	{ id: 'analytics', label: 'Analytics and Crash Reports' },
	{ id: 'purchases', label: 'In-App Purchases' },
	{ id: 'legal-bases', label: 'Legal Bases' },
	{ id: 'choices', label: 'Your Privacy Choices' },
	{ id: 'retention', label: 'Data Retention' },
	{ id: 'transfers', label: 'International Transfers' },
	{ id: 'rights', label: 'Your Rights' },
	{ id: 'california', label: 'California Privacy Rights' },
	{ id: 'deleting', label: 'Deleting Your Data' },
	{ id: 'other', label: 'Cookies, Security and Links' },
	{ id: 'children', label: 'Children’s Privacy' },
	{ id: 'changes', label: 'Changes to This Policy' },
	{ id: 'contact', label: 'Contact' },
];

const providers = [
	{ name: 'Google AdMob', platforms: 'Android and iOS', href: 'https://support.google.com/admob/answer/6128543?hl=en' },
	{ name: 'Google Analytics for Firebase', platforms: 'Android and iOS', href: 'https://firebase.google.com/policies/analytics' },
	{ name: 'Firebase Crashlytics', platforms: 'Android and iOS', href: 'https://firebase.google.com/support/privacy/' },
	{ name: 'Firebase Authentication', platforms: 'Android', href: 'https://firebase.google.com/support/privacy/' },
	{ name: 'Google Play Games Services', platforms: 'Android', href: 'https://policies.google.com/privacy' },
	{ name: 'Google Drive', platforms: 'Android', href: 'https://policies.google.com/privacy' },
	{ name: 'Google Play Services and Billing', platforms: 'Android', href: 'https://policies.google.com/privacy' },
	{ name: 'Apple App Store', platforms: 'iOS', href: 'https://www.apple.com/legal/privacy/' },
];
---

<DartProLayout
	variant="legal"
	seo={{
		title: 'Privacy Policy | Dart Pro Training Sheet',
		description:
			'Privacy Policy of the Dart Pro Training Sheet darts practice app for iPhone and Android: which data is processed for ads, analytics, crash reports, the leaderboard and Google Drive backup, and which rights you have.',
	}}
>
	<main id="content" class="dp-legal-page">
		<LegalHero eyebrow="Legal" title="Privacy Policy" meta="Effective as of 2026-10-25" />

		<div class="dp-legal">
			<div class="dp-legal__inner">
				<nav class="dp-toc" aria-labelledby="toc-label" data-toc data-reveal>
					<p id="toc-label" class="dp-toc__label">On this page</p>
					{toc.map((entry) => <a href={`#${entry.id}`}>{entry.label}</a>)}
				</nav>

				<article class="dp-legal__article">
					<p class="dp-legal__lead" data-reveal>
						Niko Börger built Dart Pro Training Sheet (the “App”) as a free, ad-supported app with an optional Premium
						upgrade. This Privacy Policy explains what information is processed when you use the App on iPhone or Android,
						why it is processed, and which choices and rights you have. The two versions differ in a few features. Where
						something applies to only one platform, this is stated.
					</p>

					<section id="controller" class="dp-legal__section" data-reveal>
						<h2>Who Is Responsible</h2>
						<p>The controller responsible for processing your personal data under the EU General Data Protection Regulation (GDPR) is:</p>
						<p>Niko Börger<br />Gottfried-Keller-Straße 9<br />22848 Norderstedt<br />Germany</p>
						<p>Email: <span data-mail>[Please enable Javascript]</span></p>
					</section>

					<section id="collection" class="dp-legal__section" data-reveal>
						<h2>Information Collection and Use</h2>
						<p>
							I do not run a server of my own, and the App has no user accounts of its own. Your training data stays on
							your device unless you decide to move it or back it up.
						</p>
						<p>
							The App uses third party services for advertising, analytics, crash reports and, on Android, for the
							leaderboard, sign-in and backup. These services may collect information that can identify you. Each provider
							processes data under its own privacy policy:
						</p>
						<div class="dp-providers">
							{
								providers.map((provider) => (
									<a class="dp-provider" href={provider.href} target="_blank" rel="noopener">
										<span>
											{provider.name}
											<span class="dp-provider__meta">{provider.platforms}</span>
										</span>
										<span class="dp-provider__arrow" aria-hidden="true">↗</span>
									</a>
								))
							}
						</div>
					</section>

					<section id="on-device" class="dp-legal__section" data-reveal>
						<h2>Data Stored on Your Device</h2>
						<p>
							Your training sheets, games, visits, scores, statistics and settings are stored <strong>only on your
							device</strong>. They are not uploaded to me.
						</p>
						<p>
							If you use your device’s own backup (iCloud or computer backups on iOS, Android Auto Backup to your Google
							account), this data can be part of that backup. These backups are handled by Apple or Google under their
							terms, and I have no access to them.
						</p>
					</section>

					<section id="backup" class="dp-legal__section" data-reveal>
						<h2>Google Sign-In and Drive Backup (Android)</h2>
						<p>
							On Android, you can optionally sign in with your Google account to back up your training sheets to Google
							Drive or to sync them between devices. Signing in is only needed for these features. Sign-in uses Firebase
							Authentication, which processes your Google account identifier, email address and name. The App shows your
							name and email address on the Transfer screen and stores an account identifier on your device so that sync
							stays connected to the same account.
						</p>
						<p>
							The App can only access files it created itself in your Google Drive. A backup is saved in your Drive in the
							folder “Dart Pro Training Sheet (Backups)” and contains your finished sheets (dates, scores, games and
							visits), your device model, the platform and the app version. The App keeps the five newest backups and
							deletes older ones. With auto-sync (Premium, off by default), the App keeps a sync file in that folder up to
							date, including a list of deleted sheets so that deletions reach your other devices.
						</p>
						<p>
							These files are stored in your own Google Drive, not on a server operated by me, and I cannot read them. You
							can sign out on the Transfer screen at any time and revoke the App’s access in your Google account settings.
						</p>
						<p>The iOS version has no sign-in and no Google Drive backup.</p>
					</section>

					<section id="leaderboard" class="dp-legal__section" data-reveal>
						<h2>Leaderboard (Android)</h2>
						<p>
							The leaderboard runs on Google Play Games Services. If you are signed in to Play Games, the App submits the
							final score of every finished sheet that passes a plausibility check. The App sends only the score. On the
							leaderboard, your score appears with your Play Games profile name and avatar, according to the visibility
							settings of your Play Games profile, which also decide whether friends can compare scores with you.
						</p>
						<p>
							You can manage your Play Games profile, its visibility and its data in the Play Games settings of your device
							or Google account. The iOS version has no leaderboard and submits no scores.
						</p>
					</section>

					<section id="transfer" class="dp-legal__section" data-reveal>
						<h2>Transfer and Sharing</h2>
						<p>
							<strong>File export and import.</strong> You can export your sheets as a file and send it through your
							device’s share sheet, or import such a file. The file contains your sheets (dates, scores, games and visits)
							and no personal identifiers.
						</p>
						<p>
							<strong>QR code transfer.</strong> Your sheets are encoded into a QR code shown on one device and scanned with
							the camera of the other device. No server is involved. The App uses the camera only while you scan and does
							not store camera images.
						</p>
						<p>
							<strong>Result image.</strong> The share image is created on your device. You decide whether to send it
							through the share sheet or save it to your photo library, for which iOS asks for your permission. When you
							take a screenshot, the App may offer to share the result image instead. It does not read or upload the
							screenshot.
						</p>
					</section>

					<section id="advertising" class="dp-legal__section" data-reveal>
						<h2>Advertising</h2>
						<p>
							The App is funded by ads delivered through Google AdMob. To show ads and measure their performance, AdMob and
							its advertising partners may process your device’s advertising identifier, advertising data (such as which
							ads you have seen or tapped), your approximate location derived from your IP address, and similar device and
							usage information. Premium users are not shown ads.
						</p>
						<p>
							When you allow tracking, your advertising identifier may be used to link your activity across other
							companies’ apps and websites in order to show personalized ads. If you do not allow tracking, the App still
							shows ads, but they are non-personalized and your advertising identifier is not used to track you.
						</p>
						<p>
							<strong>On iOS</strong>, the advertising identifier is the Identifier for Advertisers (IDFA), and the App asks
							for permission through the App Tracking Transparency prompt. You can change this at any time in iOS Settings
							under Privacy &amp; Security, then Tracking.
						</p>
						<p>
							<strong>On Android</strong>, the advertising identifier is the Google Advertising ID. You can reset or delete it
							at any time in your device settings under Google, then Ads.
						</p>
					</section>

					<section id="analytics" class="dp-legal__section" data-reveal>
						<h2>Analytics and Crash Reports</h2>
						<p>
							The App uses Google Analytics for Firebase to understand how it is used. Analytics processes usage and
							interaction data, an app instance identifier, device information such as model and operating system version,
							and your approximate location. The App also logs a few events of its own, for example the final score when
							you finish a sheet. The App does not send your name, email address or account identifier to Analytics.
						</p>
						<p>
							Firebase Crashlytics detects and diagnoses crashes and errors. A crash report contains technical information
							such as the device model, operating system version, the state of the App at the time of the error, the time
							and date of the error, and an installation identifier.
						</p>
					</section>

					<section id="purchases" class="dp-legal__section" data-reveal>
						<h2>In-App Purchases</h2>
						<p>
							The optional Premium upgrade unlocks all statistics, removes ads and adds features such as auto-sync and QR
							code scanning. It is sold as a one-time purchase or as a subscription, depending on the platform. Payments are
							processed by Google Play on Android and by the App Store on iOS, under their own privacy policies. I do not
							receive your payment details. The App checks your purchase on your device to unlock Premium.
						</p>
					</section>

					<section id="legal-bases" class="dp-legal__section" data-reveal>
						<h2>Legal Bases for Processing</h2>
						<p>I process personal data on the following legal bases under Article 6(1) GDPR:</p>
						<ul>
							<li>
								<strong>Consent</strong> (Art. 6(1)(a)): personalized advertising and analytics, where consent is required
								(see “Your Privacy Choices”). You can withdraw your consent at any time.
							</li>
							<li>
								<strong>Performance of a contract</strong> (Art. 6(1)(b)): the Google Drive backup and sync when you sign in,
								submitting your score to the leaderboard when you are signed in to Play Games, and processing your Premium
								purchase.
							</li>
							<li>
								<strong>Legitimate interests</strong> (Art. 6(1)(f)): crash reports and app stability, protecting the
								leaderboard against implausible scores, and showing non-personalized ads to fund the free App.
							</li>
						</ul>
					</section>

					<section id="choices" class="dp-legal__section" data-reveal>
						<h2>Your Privacy Choices (EEA, UK and Switzerland)</h2>
						<p>
							If you are in the European Economic Area, the United Kingdom or Switzerland, the App shows a consent message
							provided by Google’s User Messaging Platform before personalized ads and analytics are used. You can review or
							withdraw your consent at any time under “Ad Settings” in the App.
						</p>
					</section>

					<section id="retention" class="dp-legal__section" data-reveal>
						<h2>Data Retention</h2>
						<ul>
							<li>Data on your device remains until you delete it in the App or uninstall the App.</li>
							<li>Google Drive backups and sync files remain in your Drive until you delete them.</li>
							<li>Your Firebase Authentication sign-in record remains until you ask me to delete it.</li>
							<li>Leaderboard scores are kept by Google Play Games until you delete your Play Games data.</li>
							<li>Crash reports are kept by Firebase Crashlytics for 90 days.</li>
							<li>Analytics data is kept for no longer than 14 months.</li>
							<li>Advertising data is kept according to Google’s retention policies.</li>
						</ul>
					</section>

					<section id="transfers" class="dp-legal__section" data-reveal>
						<h2>International Data Transfers</h2>
						<p>
							The third party services used by the App are operated by Google and Apple, which may process data in the
							United States and other countries outside the EEA. Such transfers are based on appropriate safeguards, such as
							the EU-U.S. Data Privacy Framework and the European Commission’s Standard Contractual Clauses. You can find
							details in the providers’ privacy policies linked above.
						</p>
					</section>

					<section id="rights" class="dp-legal__section" data-reveal>
						<h2>Your Rights</h2>
						<p>If you are in the EEA, the UK or Switzerland, you have the following rights regarding your personal data:</p>
						<ul>
							<li>the right of access (Art. 15 GDPR);</li>
							<li>the right to rectification (Art. 16 GDPR);</li>
							<li>the right to erasure (Art. 17 GDPR);</li>
							<li>the right to restriction of processing (Art. 18 GDPR);</li>
							<li>the right to data portability (Art. 20 GDPR);</li>
							<li>the right to object to processing (Art. 21 GDPR);</li>
							<li>the right to withdraw consent at any time, without affecting earlier processing.</li>
						</ul>
						<p>
							To exercise these rights, contact me at <span data-mail>[Please enable Javascript]</span>. You also have the
							right to lodge a complaint with a data protection supervisory authority. The authority responsible for me is
							the Unabhängiges Landeszentrum für Datenschutz Schleswig-Holstein (ULD), but you may also contact the authority
							in your country of residence.
						</p>
					</section>

					<section id="california" class="dp-legal__section" data-reveal>
						<h2>California Privacy Rights (CCPA/CPRA)</h2>
						<p>
							If you live in California, the California Consumer Privacy Act, as amended by the California Privacy Rights
							Act, gives you additional rights. The categories of personal information processed through the App are
							identifiers (such as your advertising identifier and app instance identifier, and on Android your Google
							account email address if you sign in for backup), approximate location, app activity and diagnostic data.
						</p>
						<p>
							When personalized ads are enabled, the App lets advertising partners use your advertising identifier and
							approximate location to show ads across other companies’ apps and websites. Under California law, this may
							count as a “sale” or “sharing” of personal information. You can opt out by declining the App Tracking
							Transparency prompt on iOS, by deleting your advertising ID on Android, or by refusing consent where a consent
							message is shown.
						</p>
						<p>
							You also have the right to know which personal information is collected, to access, correct and delete it,
							and not to be discriminated against for exercising these rights. Contact me at
							<span data-mail>[Please enable Javascript]</span>.
						</p>
					</section>

					<section id="deleting" class="dp-legal__section" data-reveal>
						<h2>Deleting Your Data</h2>
						<ul>
							<li>Sheets on your device are removed when you delete them in the App or uninstall the App.</li>
							<li>
								Google Drive backups (Android) are stored in your own Drive. Delete them there, and revoke the App’s access in
								your Google account settings.
							</li>
							<li>
								Your sign-in record in Firebase Authentication (Android) is deleted on request. See
								<a href={app.paths.deleteAccount}>Delete Account</a> for how to ask.
							</li>
							<li>Leaderboard scores (Android) are deleted together with your Play Games data in the Play Games settings.</li>
						</ul>
					</section>

					<section id="other" class="dp-legal__section" data-reveal>
						<h2>Cookies, Security and Links</h2>
						<p>
							The App is a native app and does not use browser cookies. The third party services described above use device
							identifiers and similar technologies, as described in their privacy policies.
						</p>
						<p>
							I value your trust and use commercially acceptable means to protect your data. However, no method of
							transmission over the internet or of electronic storage is 100% secure, and I cannot guarantee absolute
							security.
						</p>
						<p>
							The App contains links to other sites, such as the app stores. These sites are not operated by me, and I have
							no control over their content or privacy practices. Please review their privacy policies.
						</p>
					</section>

					<section id="children" class="dp-legal__section" data-reveal>
						<h2>Children’s Privacy</h2>
						<p>
							The App is a general-audience app and is not directed to children. It is not part of Google Play’s Families
							program or Apple’s Kids category, and I do not knowingly collect personal data from children. In Germany the
							age of digital consent under the GDPR is 16; in other countries it can be as low as 13. If you are below the
							age that applies to you, please use the App only with the consent of a parent or guardian. If you are a parent
							or guardian and believe your child has provided personal data, please contact me so that I can take the
							necessary action.
						</p>
					</section>

					<section id="changes" class="dp-legal__section" data-reveal>
						<h2>Changes to This Privacy Policy</h2>
						<p>
							I may update this Privacy Policy from time to time. Changes are posted on this page together with a new
							effective date, so please review it periodically. This policy is effective as of 2026-10-25.
						</p>
					</section>

					<section id="contact" class="dp-contact" data-reveal>
						<h2>Contact</h2>
						<p>If you have any questions or suggestions about this Privacy Policy, do not hesitate to contact me.</p>
						<a href={app.paths.impressum} class="dp-contact__button" data-mail-link data-mail-text>
							<span data-mail-text-target>[Please enable Javascript]</span>
						</a>
					</section>
				</article>
			</div>
		</div>
	</main>
</DartProLayout>
