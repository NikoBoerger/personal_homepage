---
import { Image, getImage } from 'astro:assets';
import MadhouseLayout from '../../../layouts/MadhouseLayout.astro';
import { madhouse } from '../../../config/madhouse.js';
import appIcon from '../../../assets/apps/madhouse/app_icon.png';
import homeShot from '../../../assets/apps/madhouse/01-home.png';
import botShot from '../../../assets/apps/madhouse/02-bot.png';
import cricketShot from '../../../assets/apps/madhouse/03-cricket.png';
import multiplayerShot from '../../../assets/apps/madhouse/04-multiplayer.png';
import statisticsShot from '../../../assets/apps/madhouse/05-statistics.png';
import callerShot from '../../../assets/apps/madhouse/06-caller.png';
import x01TwoPlayer from '../../../assets/apps/madhouse/x01_two_player.png';
import kirkBevins from '../../../assets/apps/madhouse/kirk_bevins.png';

const description =
	'Madhouse is a darts scoring app for iPhone, iPad and Android. Score 501, 301 and Cricket, play against realistic bots or any number of friends, track detailed statistics and hear Mastercaller Kirk Bevins call every score.';

const fanWidths = [240, 280, 420, 640];
const fanSizes = '(min-width: 1200px) 204px, 34vw';
const cropWidths = [340, 560, 680];
const cropSizes = '336px';

const shots = [
	{ src: homeShot, alt: 'Madhouse home screen with the X01 game card' },
	{ src: multiplayerShot, alt: '501 darts match with score keypad' },
	{ src: botShot, alt: 'Play 501 against a bot' },
	{ src: cricketShot, alt: 'Cricket scoreboard on a chalkboard' },
	{ src: callerShot, alt: 'Mastercaller Kirk Bevins' },
	{ src: statisticsShot, alt: 'Darts statistics and averages' },
];

const absolute = (path: string) => new URL(path, Astro.site).href;
const screenshotUrls = await Promise.all(
	shots.map(async ({ src }) => absolute((await getImage({ src, width: 600, format: 'webp' })).src))
);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'MobileApplication',
	name: 'Madhouse',
	alternateName: ['Madhouse Darts', 'Madhouse Dart Counter / Scorer'],
	url: absolute(madhouse.paths.home),
	applicationCategory: 'SportsApplication',
	operatingSystem: 'iOS, iPadOS, Android',
	inLanguage: ['en', 'de'],
	description: 'Darts scoring app for X01 and Cricket with bots, multiplayer, statistics and Mastercaller Kirk Bevins.',
	image: absolute(madhouse.iconPath),
	screenshot: screenshotUrls,
	author: { '@type': 'Person', name: 'Niko Börger', url: absolute('/') },
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
	installUrl: [madhouse.appStoreUrl, madhouse.playUrl],
};
---

<MadhouseLayout
	variant="home"
	seo={{
		title: 'Madhouse – Darts Scoring App for X01 & Cricket | iPhone, iPad & Android',
		description,
		keywords: 'darts scoring app, darts scorer, darts counter, 501, X01, cricket darts, darts bot, darts statistics, darts caller',
		ogTitle: 'Madhouse – A beautiful, easy darts scoring app for 501 and Cricket',
		ogDescription:
			'X01 and Cricket, realistic bots, unlimited players, extensive statistics and Mastercaller Kirk Bevins. For iPhone, iPad and Android.',
	}}
	jsonLd={jsonLd}
>
	<main id="content">
		<section aria-labelledby="hero-title" class="mh-hero">
			<div class="mh-hero__inner">
				<div class="mh-hero__copy">
					<h1 id="hero-title" class="mh-hero__title" data-intro>The darts scorer that looks as good as your best leg.</h1>
					<p class="mh-hero__lead" data-intro style="--mh-delay: 120ms">
						Beautiful, easy to use and complete. Score X01 and Cricket in big numbers you can read from the oche, train
						against bots that play like real people and let Mastercaller Kirk Bevins call every score.
					</p>
					<div class="mh-badges" data-intro style="--mh-delay: 240ms">
						<a href={madhouse.appStoreUrl} aria-label="Download Madhouse on the App Store" class="mh-badge">
							<img src="/assets/apps/madhouse/badge_app_store.svg" alt="Download on the App Store" width="189" height="56" />
						</a>
						<a href={madhouse.playUrl} aria-label="Get Madhouse on Google Play" class="mh-badge">
							<img src="/assets/apps/madhouse/badge_google_play.svg" alt="Get it on Google Play" width="189" height="56" />
						</a>
					</div>
					<p class="mh-hero__platforms" data-intro style="--mh-delay: 340ms">iPhone · iPad · Android · English &amp; Deutsch</p>
				</div>

				<div class="mh-hero__visual">
					<div aria-label="Madhouse app screenshots" role="img" class="mh-fan">
						<Image src={statisticsShot} alt="" widths={fanWidths} sizes={fanSizes} loading="eager" class="mh-fan__shot mh-fan__shot--outer-left" data-intro="fan" style="--mh-delay: 420ms" />
						<Image src={botShot} alt="" widths={fanWidths} sizes={fanSizes} loading="eager" class="mh-fan__shot mh-fan__shot--inner-left" data-intro="fan" style="--mh-delay: 300ms" />
						<Image src={callerShot} alt="" widths={fanWidths} sizes={fanSizes} loading="eager" class="mh-fan__shot mh-fan__shot--outer-right" data-intro="fan" style="--mh-delay: 420ms" />
						<Image src={cricketShot} alt="" widths={fanWidths} sizes={fanSizes} loading="eager" class="mh-fan__shot mh-fan__shot--inner-right" data-intro="fan" style="--mh-delay: 300ms" />
						<Image
							src={multiplayerShot}
							alt="Madhouse darts scoring app: 501 match with score keypad"
							widths={fanWidths}
							sizes={fanSizes}
							loading="eager"
							fetchpriority="high"
							class="mh-fan__shot mh-fan__shot--center"
							data-intro="fan"
							style="--mh-delay: 120ms"
						/>
					</div>
				</div>
			</div>
		</section>

		<section id="features" aria-labelledby="features-title" class="mh-features">
			<div class="mh-features__inner">
				<div class="mh-section-head" data-reveal>
					<p class="mh-eyebrow">Features</p>
					<h2 id="features-title" class="mh-section-title">Every feature you need. Simple to use.</h2>
				</div>

				<div class="mh-cards">
					<article class="mh-card mh-card--teal" data-reveal>
						<div class="mh-card__text">
							<h3 class="mh-card__title">X01</h3>
							<p class="mh-card__body">
								Big, clear scores you can read from the oche. 501, 301, 170 and more, with sets and legs, double or single
								out. Two players sit side by side, and any number of friends can join.
							</p>
						</div>
						<div class="mh-card__media">
							<div class="mh-phone">
								<Image src={x01TwoPlayer} alt="Two-player 501 match in Madhouse with score keypad" widths={[280, 414]} sizes="241px" />
							</div>
						</div>
					</article>
					<article class="mh-card mh-card--navy" data-reveal style="--mh-delay: 120ms">
						<div class="mh-card__text">
							<h3 class="mh-card__title">Bots that throw like real players</h3>
							<p class="mh-card__body">
								Pick a level from beginner to pro. Bots aim the way people do and miss the way people do, so training
								against them feels like a real match.
							</p>
						</div>
						<div class="mh-card__media mh-card__media--bottom">
							<Image src={botShot} alt="A Madhouse bot throwing three darts at the 20 on the dartboard" widths={cropWidths} sizes={cropSizes} class="mh-crop mh-crop--bot" />
						</div>
					</article>
					<article class="mh-card mh-card--teal" data-reveal>
						<div class="mh-card__text">
							<h3 class="mh-card__title">Cricket, like on a chalkboard</h3>
							<p class="mh-card__body">
								The whole screen is the board: marks drawn in chalk, numbers big enough to read from the oche, points counted
								for you.
							</p>
						</div>
						<div class="mh-card__media">
							<Image src={cricketShot} alt="Madhouse Cricket scoreboard drawn like a chalkboard" widths={cropWidths} sizes={cropSizes} class="mh-crop mh-crop--cricket" />
						</div>
					</article>
					<article class="mh-card mh-card--navy" data-reveal style="--mh-delay: 120ms">
						<div class="mh-card__text">
							<h3 class="mh-card__title">Extensive statistics</h3>
							<p class="mh-card__body">
								See how your game develops: average, first 9 average and a summary for every match. Filter by player, game
								and time range.
							</p>
						</div>
						<div class="mh-card__media">
							<Image src={statisticsShot} alt="Madhouse darts statistics with average chart" widths={cropWidths} sizes={cropSizes} class="mh-crop mh-crop--stats" />
						</div>
					</article>
				</div>

				<article class="mh-caller" data-reveal>
					<div class="mh-caller__text">
						<p class="mh-eyebrow">The voice of the stage</p>
						<h3 class="mh-caller__title">Mastercaller Kirk Bevins calls every score.</h3>
						<p class="mh-caller__body">Every visit, every game shot. Prefer silence? Switch the caller off in the settings.</p>
					</div>
					<div class="mh-caller__visual" data-reveal="right" style="--mh-delay: 200ms">
						<Image
							src={kirkBevins}
							alt="Mastercaller Kirk Bevins with microphone"
							widths={[400, 620, 768]}
							sizes="(min-width: 1240px) 620px, (min-width: 820px) 50vw, 100vw"
						/>
					</div>
				</article>
			</div>
		</section>

		<section id="screenshots" aria-labelledby="shots-title" class="mh-shots">
			<div class="mh-shots__head" data-reveal>
				<div class="mh-section-head">
					<p class="mh-eyebrow">Screenshots</p>
					<h2 id="shots-title" class="mh-section-title">Take a look inside.</h2>
				</div>
				<p class="mh-shots__hint">Scroll sideways <span class="mh-shots__arrow" aria-hidden="true">→</span></p>
			</div>
			<div class="mh-shots__track">
				{
					shots.map((shot, index) => (
						<figure class="mh-shot" data-reveal="right" style={`--mh-delay: ${index * 90}ms`}>
							<Image src={shot.src} alt={shot.alt} widths={[300, 600, 900]} sizes="(min-width: 1250px) 300px, max(230px, 24vw)" />
						</figure>
					))
				}
			</div>
		</section>

		<section aria-label="About the maker" class="mh-maker">
			<div class="mh-maker__inner">
				<p class="mh-maker__quote" data-reveal>
					“I was playing league darts almost every day, and no app I tried was right. They were ugly, hard to use, had
					bots that didn’t play like real people, or you couldn’t read them from the oche, especially in Cricket. So I
					built Madhouse: <span class="mh-maker__highlight">beautiful, as simple as possible, with every feature you need.</span>”
				</p>
				<div class="mh-maker__byline" data-reveal style="--mh-delay: 150ms">
					<span class="mh-maker__rule"></span>
					<span class="mh-maker__name">Niko</span>
					<span class="mh-maker__role">Former league player and maker of Madhouse</span>
				</div>
			</div>
		</section>

		<section id="download" aria-labelledby="download-title" class="mh-download">
			<div class="mh-download__inner">
				<div data-reveal="pop">
					<Image src={appIcon} alt="Madhouse app icon" width={112} height={112} densities={[1, 2, 3]} class="mh-download__icon" />
				</div>
				<h2 id="download-title" class="mh-download__title" data-reveal style="--mh-delay: 100ms">Game on.</h2>
				<p class="mh-download__body" data-reveal style="--mh-delay: 180ms">
					Download Madhouse and score your next training session or match.
				</p>
				<div class="mh-badges mh-badges--center" data-reveal style="--mh-delay: 260ms">
					<a href={madhouse.appStoreUrl} aria-label="Download Madhouse on the App Store" class="mh-badge">
						<img src="/assets/apps/madhouse/badge_app_store.svg" alt="Download on the App Store" width="189" height="56" loading="lazy" />
					</a>
					<a href={madhouse.playUrl} aria-label="Get Madhouse on Google Play" class="mh-badge">
						<img src="/assets/apps/madhouse/badge_google_play.svg" alt="Get it on Google Play" width="189" height="56" loading="lazy" />
					</a>
				</div>
			</div>
		</section>
	</main>
</MadhouseLayout>
