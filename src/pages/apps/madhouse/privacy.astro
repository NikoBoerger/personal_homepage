---
import AppLayout from '../../../layouts/AppLayout.astro';
---

<AppLayout
	app="madhouse"
	seo={{
		title: 'Privacy Policy | Madhouse',
		description: 'Privacy Policy for the Madhouse darts scoring app.',
	}}
>
	<h1>Privacy Policy</h1>

	<section class="app-card">
		<p class="app-muted">Effective date: <strong>06.09.2025</strong></p>
		<p>
			<strong>Madhouse</strong> respects your privacy. This Privacy Policy explains how we collect, use, and
			protect information when you use our mobile application.
		</p>
	</section>

	<section class="app-card">
		<h2>Information We Collect</h2>
		<p>
			We use <strong>Firebase Analytics</strong>, a service provided by Google, to understand how our app is
			used and to improve its performance and features. Firebase Analytics automatically collects certain
			information, which may include:
		</p>
		<ul>
			<li>Device information (e.g., model, operating system version)</li>
			<li>App usage data (e.g., screens viewed, actions taken)</li>
			<li>General location information (e.g., country, region)</li>
		</ul>
		<p>
			We <strong>do not</strong> collect personally identifiable information such as your name, phone number, or
			precise location.
		</p>
	</section>

	<section class="app-card">
		<h2>How We Use the Information</h2>
		<p>The information collected through Firebase Analytics is used solely for:</p>
		<ul>
			<li>Monitoring app performance</li>
			<li>Improving the user experience</li>
			<li>Understanding how users interact with the app</li>
		</ul>
		<p>We do not sell or share your data with third parties for marketing or advertising purposes.</p>
	</section>

	<section class="app-card">
		<h2>Third-Party Services</h2>
		<p>
			Our app uses Firebase Analytics, which is provided by Google. For details about how Google handles data in
			Firebase, please refer to Google's privacy documentation:
		</p>
		<p>
			<a href="https://firebase.google.com/support/privacy" target="_blank" rel="noopener">
				Google - Privacy &amp; Security in Firebase
			</a>
		</p>
	</section>

	<section class="app-card">
		<h2>Data Retention</h2>
		<p>
			Analytics data is retained by Firebase according to Google’s policies. We do not store this analytics data
			ourselves.
		</p>
	</section>

	<section class="app-card">
		<h2>Your Choices</h2>
		<p>
			You can opt out of Firebase Analytics data collection by following Google’s instructions for disabling
			analytics or using relevant device settings. For more information and opt-out tools, see:
		</p>
		<p>
			<a href="https://tools.google.com/dlpage/gaoptout/" target="_blank" rel="noopener">
				Google Analytics Opt-out
			</a>
		</p>
	</section>

	<section class="app-card">
		<h2>Contact Us</h2>
		<p>
			If you have any questions or concerns about this Privacy Policy, please contact us at
			<span class="app-mail">[Please enable Javascript]</span>.
		</p>
	</section>
</AppLayout>
